# Cargo outputs
target/

# Property-test regressions are committed beside their tests.
!tests/**/*.proptest-regressions

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Run outputs
output/
*.log

# Python bytecode. Two of these were tracked, so every `pytest` run in
# `crates/aequitas-python` reported a dirty tree; the files are derived from
# the sources beside them and are interpreter- and pytest-version-specific.
__pycache__/
*.py[cod]
